  +// ---------------------------------------------------------------------------
  +// TT-LEDGER — temporary vllm.cpp diagnostic instrumentation (NOT upstream).
  +// Gate: TT_LEDGER=1 in the environment. Logs every Buffer allocation/free with
  +// the allocation's host call site (module-relative backtrace frames) so a
  +// post-pass can name which call-site class retains device DRAM across
  +// requests. Zero overhead when the env is absent.
  +// ---------------------------------------------------------------------------
  +#include <cstdio>
  +#include <cstdlib>
  +#include <cstring>
  +#include <execinfo.h>
  +#include <dlfcn.h>
  +#include <unordered_map>
  +
  +namespace tt::tt_metal {
  +namespace {
  +bool ttledger_enabled() {
  +    static const bool on = std::getenv("TT_LEDGER") != nullptr;
  +    return on;
  +}
  +std::mutex& ttledger_mtx() {
  +    static std::mutex m;
  +    return m;
  +}
  +// Resolve a host PC to "<module-basename>+0x<offset>" (small cache; frames repeat).
  +void ttledger_frame(uintptr_t pc, char* out, size_t outsz) {
  +    static std::unordered_map<uintptr_t, std::pair<std::string, uintptr_t>> cache;
  +    auto it = cache.find(pc);
  +    if (it == cache.end()) {
  +        Dl_info info{};
  +        if (dladdr(reinterpret_cast<void*>(pc), &info) && info.dli_fname != nullptr) {
  +            std::string full(info.dli_fname);
  +            size_t slash = full.rfind('/');
  +            std::string base = slash == std::string::npos ? full : full.substr(slash + 1);
  +            it = cache.emplace(pc, std::make_pair(std::move(base), pc - reinterpret_cast<uintptr_t>(info.dli_fbase))).first;
  +        } else {
  +            it = cache.emplace(pc, std::make_pair(std::string("?"), 0)).first;
  +        }
  +    }
  +    std::snprintf(out, outsz, "%s+0x%llx", it->second.first.c_str(),
  +                  static_cast<unsigned long long>(it->second.second));
  +}
  +void ttledger_log(char kind, const Buffer* buffer, DeviceAddr address) {
  +    if (!ttledger_enabled()) return;
  +    bool want_bt = kind == 'A' &&
  +                   (buffer->buffer_type() == BufferType::DRAM ||
  +                    buffer->buffer_type() == BufferType::TRACE);
  +    void* frames[26] = {};
  +    int nframes = 0;
  +    if (want_bt) nframes = ::backtrace(frames, 26);
  +    const std::string& ctx = current_allocation_context();
  +    std::lock_guard<std::mutex> g(ttledger_mtx());
  +    {
  +        auto tname = enchantum::to_string(buffer->buffer_type());
  +        std::fprintf(stderr, "[TTLEDGER] %c id=%llu type=%.*s addr=%llu size=%llu",
  +                      kind,
  +                      static_cast<unsigned long long>(buffer->unique_id()),
  +                      static_cast<int>(tname.size()), tname.data(),
  +                      static_cast<unsigned long long>(address),
  +                      static_cast<unsigned long long>(buffer->aligned_size()));
  +    }
  +    if (!ctx.empty()) std::fprintf(stderr, " ctx='%s'", ctx.c_str());
  +    if (nframes > 2) {
  +        std::fprintf(stderr, " bt=");
  +        char buf[128];
  +        for (int i = 2; i < nframes; ++i) {  // skip ttledger_log + allocate_buffer
  +            ttledger_frame(reinterpret_cast<uintptr_t>(frames[i]), buf, sizeof(buf));
  +            std::fprintf(stderr, "%s%s", i > 2 ? ";" : "", buf);
  +        }
  +    }
  +    std::fprintf(stderr, "\n");
  +}
  +}  // namespace
  +}  // namespace tt::tt_metal
